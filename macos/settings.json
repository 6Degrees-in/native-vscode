			"list.activeSelectionForeground": "#1D1D1F",
			"list.inactiveSelectionBackground": "#E7E7EA",
			"list.inactiveSelectionForeground": "#515154",
			"list.focusBackground": "#DADAE0",
			"list.focusForeground": "#1D1D1F",
			"editorGroupHeader.tabsBackground": "#F2F2F4",
			"editorGroupHeader.noTabsBackground": "#F2F2F4",
			"tab.activeBackground": "#FCFCFC",
			"tab.activeForeground": "#1D1D1F",
			"tab.inactiveBackground": "#F2F2F4",
			"tab.inactiveForeground": "#6E6E73",
			"tab.hoverBackground": "#E7E7EA",
			"tab.border": "#C8C8CD",
			"tab.activeBorder": "#007AFF",
			"editorGroupHeader.border": "#C8C8CD",
			"panel.background": "#F3F3F5",
			"panel.border": "#C8C8CD",
			"panelTitle.activeForeground": "#1D1D1F",
			"panelTitle.inactiveForeground": "#6E6E73",
			"panelTitle.activeBorder": "#007AFF",
			"statusBar.background": "#EAEAEF",
			"statusBar.foreground": "#515154",
			"statusBar.noFolderBackground": "#EAEAEF",
			"statusBar.noFolderForeground": "#515154",
			"statusBar.debuggingBackground": "#FFC983",
			"statusBar.debuggingForeground": "#1D1D1F",
			"input.background": "#FFFFFF",
			"input.foreground": "#1D1D1F",
			"input.border": "#C8C8CD",
			"input.placeholderForeground": "#6E6E73",
			"inputOption.activeBorder": "#007AFF",
			"dropdown.background": "#FFFFFF",
			"dropdown.foreground": "#1D1D1F",
			"dropdown.border": "#C8C8CD",
			"button.background": "#007AFF",
			"button.foreground": "#FFFFFF",
			"button.hoverBackground": "#006FE6",
			"badge.background": "#007AFF",
			"badge.foreground": "#FFFFFF",
			"focusBorder": "#007AFF",
			"contrastBorder": "#C8C8CD",
			"contrastActiveBorder": "#007AFF",
			"scrollbarSlider.background": "#8E8E9344",
			"scrollbarSlider.hoverBackground": "#8E8E9366",
			"scrollbarSlider.activeBackground": "#6E6E7399",
			"terminal.background": "#F3F3F5",
			"terminal.foreground": "#1D1D1F",
			"terminalCursor.foreground": "#1D1D1F"
		}
	},
	"editor.tokenColorCustomizations": {
		"[Ayu Mojave]": {
			"textMateRules": [
				{
					"scope": ["comment", "punctuation.definition.comment"],
					"settings": {
						"foreground": "#8E8E93"
					}
				}
			]
		},
		"[Ra Spring]": {
			"textMateRules": [
				{
					"scope": ["comment", "punctuation.definition.comment"],
					"settings": {
						"foreground": "#6E6E73"
					}
				}
			]
		}
	},
	"git.enableSmartCommit": true,
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"prettier.useTabs": true,
	"prettier.printWidth": 200,
	"prettier.proseWrap": "never",
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	}
}