{
	"editor.fontFamily": "JetBrains Mono Light",
	"editor.fontSize": 13.5,
	"editor.lineHeight": 1.25,
	"terminal.integrated.fontFamily": "Menlo",
	"terminal.integrated.fontSize": 13.5,
	"terminal.integrated.lineHeight": 1.05,
	"editor.minimap.enabled": false,
	"editor.wordWrap": "on",
	"editor.accessibilitySupport": "off",
	"window.autoDetectColorScheme": true,
	"window.nativeTabs": true,
	"window.titleBarStyle": "native",
	"window.customTitleBarVisibility": "never",
	"window.commandCenter": false,
	"workbench.preferredDarkColorTheme": "Ayu Mojave",
	"workbench.preferredLightColorTheme": "Ra Spring",
	"workbench.colorTheme": "Ayu Mojave",
	"workbench.iconTheme": "vscode-icons-mac",
	"workbench.productIconTheme": "fluent-icons",
	"workbench.startupEditor": "none",
	"workbench.colorCustomizations": {
		"[Ayu Mojave]": {
			"editor.background": "#262627",
			"editor.foreground": "#F5F5F7",
			"editor.lineHighlightBackground": "#2B2B2D",
			"editor.selectionBackground": "#3A3A3C",
			"editor.inactiveSelectionBackground": "#303033",
			"activityBar.background": "#222223",
			"activityBar.foreground": "#F5F5F7",
			"activityBar.inactiveForeground": "#8E8E93",
			"activityBar.activeBorder": "#0A84FF",
			"sideBar.background": "#222223",
			"sideBar.foreground": "#F5F5F7",
			"sideBarSectionHeader.background": "#282829",
			"sideBarSectionHeader.foreground": "#F5F5F7",
			"list.hoverBackground": "#2B2B2D",
			"list.activeSelectionBackground": "#343437",
			"list.activeSelectionForeground": "#F5F5F7",
			"list.inactiveSelectionBackground": "#2B2B2D",
			"list.inactiveSelectionForeground": "#D1D1D6",
			"list.focusBackground": "#343437",
			"list.focusForeground": "#F5F5F7",
			"editorGroupHeader.tabsBackground": "#222223",
			"editorGroupHeader.noTabsBackground": "#222223",
			"tab.activeBackground": "#262627",
			"tab.activeForeground": "#F5F5F7",
			"tab.inactiveBackground": "#222223",
			"tab.inactiveForeground": "#8E8E93",
			"tab.hoverBackground": "#2B2B2D",
			"tab.border": "#3A3A3C",
			"tab.activeBorder": "#0A84FF",
			"editorGroupHeader.border": "#3A3A3C",
			"panel.background": "#232324",
			"panel.border": "#38383A",
			"panelTitle.activeForeground": "#F5F5F7",
			"panelTitle.inactiveForeground": "#8E8E93",
			"panelTitle.activeBorder": "#0A84FF",
			"statusBar.background": "#202021",
			"statusBar.foreground": "#8E8E93",
			"statusBar.noFolderBackground": "#202021",
			"statusBar.noFolderForeground": "#8E8E93",
			"statusBar.debuggingBackground": "#8A5A00",
			"statusBar.debuggingForeground": "#FFFFFF",
			"input.background": "#2B2B2D",
			"input.foreground": "#F5F5F7",
			"input.border": "#48484A",
			"input.placeholderForeground": "#8E8E93",
			"inputOption.activeBorder": "#0A84FF",
			"dropdown.background": "#2B2B2D",
			"dropdown.foreground": "#F5F5F7",
			"dropdown.border": "#48484A",
			"button.background": "#0A84FF",
			"button.foreground": "#FFFFFF",
			"button.hoverBackground": "#0077ED",
			"badge.background": "#0A84FF",
			"badge.foreground": "#FFFFFF",
			"focusBorder": "#0A84FF",
			"contrastBorder": "#38383A",
			"contrastActiveBorder": "#0A84FF",
			"scrollbarSlider.background": "#63636666",
			"scrollbarSlider.hoverBackground": "#8E8E9399",
			"scrollbarSlider.activeBackground": "#AEAEB2AA",
			"terminal.background": "#232324",
			"terminal.foreground": "#F5F5F7",
			"terminalCursor.foreground": "#F5F5F7"
		},
		"[Ra Spring]": {
			"editor.background": "#FCFCFC",
			"editor.foreground": "#1D1D1F",
			"editor.lineHighlightBackground": "#F7F7F8",
			"editor.selectionBackground": "#D7E8FF",
			"editor.inactiveSelectionBackground": "#E8E8ED",
			"activityBar.background": "#F2F2F4",
			"activityBar.foreground": "#1D1D1F",
			"activityBar.inactiveForeground": "#6E6E73",
			"activityBar.activeBorder": "#007AFF",
			"sideBar.background": "#F2F2F4",
			"sideBar.foreground": "#1D1D1F",
			"sideBarSectionHeader.background": "#EAEAEF",
			"sideBarSectionHeader.foreground": "#1D1D1F",
			"list.hoverBackground": "#E7E7EA",
